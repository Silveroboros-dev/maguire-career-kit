  "findings": [
    {
      "code": "candidate_evidence_level",
      "examples": [
        "D01",
        "D03",
        "D04"
      ],
      "observation": "First-person candidate facts are normalized as observation in D01 fact_1 and CF2-04 fact_1, while comparable first-person facts retain self_report. This upgrades the source evidence level.",
      "requested_correction": "Use self_report for these source propositions and preserve that level in supported-claim explanations.",
      "severity": "needs_change"
    },
    {
      "code": "sample_application_overstated",
      "examples": [
        "D03",
        "D04"
      ],
      "observation": "CF2-04 says a checklist was applied to a 75-page sample; candidate/archive_processing/archive_pages with count 75, and D03 c1 as candidate processing, can overstate coordination of archive processing.",
      "requested_correction": "Represent the sample/checklist application narrowly; keep the more-than-200000 production claim separate and unsupported.",
      "severity": "needs_change"
    },
    {
      "code": "later_observation_not_publication",
      "examples": [
        "D13"
      ],
      "observation": "D13 c2 treats bare “later than the remote notice” as an unambiguous observed_after world claim. The inputs supply observation timestamps, not publication or effective dates; the wording admits more than one reading.",
      "requested_correction": "Retain observed-order and publication/effective-order alternatives, or mark the date premise unresolved. Do not infer governing authority from either date.",
      "severity": "needs_change"
    },
    {
      "code": "newer_reference_coverage",
      "examples": [
        "D10",
        "D11"
      ],
      "observation": "The selected fragment includes “newer flexibility note”, but only the negative resolves atom is represented. “Newer” can be grounded in observed order only if explicitly bounded that way.",
      "requested_correction": "Represent the observed-order reference as a separate packet-scoped atom or narrow the selected span; retain the negative resolves claim and avoid a publication-date assertion.",
      "severity": "needs_change"
    },
    {
      "code": "soft_discussion_wording",
      "examples": [
        "D10",
        "D11",
        "D12",
        "D13"
      ],
      "observation": "The September source says arrangements “should be discussed with the team”; scope.requires_team_discussion=true may read as a mandatory condition stronger than the text.",
      "requested_correction": "Use a softer discussion-advised representation or document the restricted interpretation. It must not create a governing or supersession edge.",
      "severity": "review_note"
    }
  ],
  "human_approved": false,
